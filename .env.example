# Copy this file to .env and fill in real values. Never commit .env.

# --- Trading 212 ---
# Generate at: Trading 212 app/web > Settings > API (Beta)
# You'll be shown BOTH an API Key and an API Secret -- the secret is shown only
# once, so copy it immediately. mode = "demo" (practice, no real money) or "live"
TRADING212_API_MODE=demo
TRADING212_API_KEY=
TRADING212_API_SECRET=

# --- Slack notifications ---
# Create at: https://api.slack.com/apps -> your app -> Incoming Webhooks -> Add New Webhook to Workspace
# Pick the channel (or a DM to yourself) it should post to.
SLACK_WEBHOOK_URL=
